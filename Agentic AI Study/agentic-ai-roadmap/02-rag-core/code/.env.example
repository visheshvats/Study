# Phase 2 — RAG Core — environment template
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in real values when you are ready
# to run against real APIs (set USE_MOCK = False in the scripts).
#
#     cp .env.example .env       # macOS/Linux
#     copy .env.example .env     # Windows
#
# Java analogy: this is your application.properties.example — committed as a
# template, while the real `.env` (with secrets) is .gitignore'd and NEVER committed.
# ------------------------------------------------------------------

# Used by OpenAIEmbeddings(model="text-embedding-3-small") in 03/04/05/06.
OPENAI_API_KEY=sk-your-openai-key-here

# Used by ChatAnthropic(model="claude-sonnet-4-6") in 05/06.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
