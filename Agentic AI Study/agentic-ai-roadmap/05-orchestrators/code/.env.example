# Phase 5 — Orchestrators environment template
#
# Copy this file to `.env` and fill in your key, OR export the variable in your
# shell. This is ONLY needed when you set USE_MOCK = False in the scripts to use
# the real Anthropic model. With USE_MOCK = True (the default), no key is needed.
#
#   Windows (PowerShell):  $env:ANTHROPIC_API_KEY="sk-ant-..."
#   macOS / Linux:         export ANTHROPIC_API_KEY="sk-ant-..."

ANTHROPIC_API_KEY=your-anthropic-api-key-here
