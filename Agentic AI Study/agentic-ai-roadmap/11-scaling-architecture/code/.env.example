# Phase 11 — environment template. Copy to `.env` and fill in real values.
# `cp .env.example .env` then `export $(grep -v '^#' .env | xargs)` (or use python-dotenv).
#
# All three demo scripts default to USE_MOCK=True and run with NONE of these set.
# Set USE_MOCK=false ONLY when the corresponding real service is available.

# Toggle the offline mocks (FakeRedis / MemorySaver / Celery eager) off.
# Leave as "true" to run everything with zero infrastructure.
USE_MOCK=true

# --- 11.1 / 11.3 : Redis (session store, Celery broker + backend) ---
# Real format: redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# --- 11.2 : PostgreSQL (durable LangGraph checkpoints) ---
# Real format: postgresql://user:password@host:port/dbname
# Leave EMPTY to force the MemorySaver fallback even when USE_MOCK=false.
DATABASE_URL=postgresql://user:password@localhost:5432/agent_db

# --- Optional: real LLM calls in the orchestrator ---
# Never commit a real key. Use a secrets manager in production.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
