# Phase 8 — Advanced RAG — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values, OR leave USE_MOCK = True in
# the scripts to run fully offline with no keys.
#
#   cp .env.example .env
#
# Never commit your real .env. Load it with python-dotenv or your shell.

# Anthropic — required when USE_MOCK = False (ChatAnthropic / create_react_agent).
ANTHROPIC_API_KEY=your-anthropic-key-here

# OpenAI — optional; only if you swap in OpenAI embeddings/models for the retriever.
OPENAI_API_KEY=your-openai-key-here

# Tavily — required for the REAL web-search fallback in CRAG / agentic RAG.
# Get a free key (1,000 credits/mo) at https://docs.tavily.com/documentation/quickstart
TAVILY_API_KEY=your-tavily-key-here
