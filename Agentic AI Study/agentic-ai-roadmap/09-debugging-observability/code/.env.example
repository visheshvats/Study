# Phase 9 — Debugging & Observability — example environment.
# Copy to `.env` and fill in real values to run the demos against live backends.
# NEVER commit your real .env. All demos run OFFLINE without these set.

# ── LangSmith tracing (9.1) ──────────────────────────────────────────────────
# CRITICAL: these must be in the environment BEFORE any LangChain/LangGraph import,
# or auto-instrumentation silently does nothing (the #1 Java-dev gotcha).
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_real_key_here
LANGCHAIN_PROJECT=agentic-ai-dev        # named bucket of traces ≈ a Jaeger service name

# ── Anthropic (9.4 token tracking) ───────────────────────────────────────────
# Needed only to make REAL client.messages.create(...) calls; response.usage then
# carries input_tokens/output_tokens for live cost math.
ANTHROPIC_API_KEY=sk-ant-your_real_key_here
