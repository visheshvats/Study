# Phase 6 — Evaluator & Optimizer environment
#
# The demos default to USE_MOCK = True and need NO key to run.
# Set USE_MOCK = False in a script and provide this key to use the real model
# (ChatAnthropic(model="claude-sonnet-4-6")).
#
# Copy this file to ".env" and fill in your key. NEVER commit the real .env.

ANTHROPIC_API_KEY=your-anthropic-api-key-here
