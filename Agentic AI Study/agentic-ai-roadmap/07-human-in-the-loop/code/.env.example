# Phase 7 — Human in the Loop — environment template
# Copy to ".env" and fill in. NEVER commit the real .env (add it to .gitignore).
# Java analogy: this is your application.properties / application.yml, but the
# secret value lives only in the untracked .env (like an externalised secret).
#
# Only needed when you flip USE_MOCK = False in the scripts. The offline demos
# run end-to-end WITHOUT this key.

ANTHROPIC_API_KEY=sk-ant-your-key-here
