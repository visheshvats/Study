# Phase 4 — environment template.
# Copy this file to `.env` and fill in your real key:
#     cp .env.example .env
#
# This file (.env.example) is safe to commit. The real `.env` must NEVER be
# committed — it is in .gitignore. (Java analogy: .env.example is the checked-in
# application.properties template; .env is your local, secret override.)
#
# You only need this when you set USE_MOCK = False in the scripts. With the
# default USE_MOCK = True, everything runs offline and no key is required.

ANTHROPIC_API_KEY=sk-ant-your-key-here
